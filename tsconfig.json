{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "web/src/**/*.ts",
    "tests/browser/**/*.ts",
    "tests/browser-kernel/**/*.ts",
    "vite.config.ts",
    "playwright.browser-kernel.config.ts",
    "playwright.browser-static.config.ts"
  ]
}
