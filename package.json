{
  "name": "didaction-jupyter-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/notebook-wasm --target web --out-dir ../../web/pkg",
    "build": "pnpm build:wasm && vite build",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wasm-pack": "0.13.1"
  }
}
