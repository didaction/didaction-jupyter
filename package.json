{
  "name": "didaction-jupyter-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/notebook-wasm --target web --out-dir ../../web/pkg",
    "prepare:browser-kernel": "node scripts/prepare-browser-kernel.mjs",
    "build:server": "pnpm build:wasm && vite build --mode server",
    "build:browser": "pnpm prepare:browser-kernel && pnpm build:wasm && vite build --mode browser --outDir ../dist-browser",
    "serve:browser": "vite preview --mode browser --host 127.0.0.1 --port 5175 --outDir ../dist-browser",
    "dev:browser": "pnpm prepare:browser-kernel && vite --mode browser --host 127.0.0.1 --port 5175",
    "test:browser-kernel": "playwright test --config playwright.browser-kernel.config.ts",
    "test:browser-static": "playwright test --config playwright.browser-static.config.ts",
    "build": "pnpm build:server",
    "dev": "vite --mode server --host 127.0.0.1 --port 5173",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wasm-pack": "0.13.1"
  },
  "dependencies": {
    "@jupyterlite/pyodide-kernel": "0.8.5",
    "assemblyscript": "0.28.9",
    "pyodide": "314.0.5"
  }
}
